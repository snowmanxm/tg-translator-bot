telegram:
  # Watcher account A. This is the Telegram user account that receives Chinese messages.
  api_id: "${TELEGRAM_API_ID}"
  api_hash: "${TELEGRAM_API_HASH}"
  session_name: "/app/sessions/user_session"

  # Sender bot. User B must start this bot before it can send private messages.
  bot_session_name: "/app/sessions/translator_bot_session"
  bot_token: "${TELEGRAM_BOT_TOKEN}"
  send_translations_to_chat_id: "${TELEGRAM_BOT_CHAT_ID}"
  send_summaries_to_chat_id: "${TELEGRAM_BOT_CHAT_ID}"
  control_chat_id: "${TELEGRAM_BOT_CHAT_ID}"

openai:
  api_key: "${OPENAI_API_KEY}"
  translation_model: "gpt-4.1-mini"
  summary_model: "gpt-4.1-mini"
  alert_model: "gpt-4.1-mini"

mongodb:
  uri: "${MONGODB_URI}"

features:
  instant_translation: true
  batch_translation: true
  hourly_summary: true
  daily_summary: true
  original_plus_translation: true
  translation_only_view: false
  important_points: true
  action_items: true
  meeting_detection: true
  unread_catchup: true

alerts:
  name_mentions_enabled: true
  names:
    - "your name"
    - "your nickname"
  question_request_alert: true
  urgency_alert: true

chats:
  - id: -1001111111111
    name: "Example Work Group"
    enabled: true
    instant_translation: true
    summaries: true
    important_only: false
    muted: false

ignore:
  users: []
  chats: []

summary:
  hourly_cron: "0 * * * *"
  daily_cron: "0 21 * * *"
  timezone: "UTC"
  combined_summary: true
  per_chat_summary: true

storage:
  auto_delete_after_days: 30

runtime:
  config_reload_enabled: true
  command_prefix: "/"
